# Copia este archivo como .env y completa los valores. .env NO se sube a git.
# Supabase → Project Settings → API
#
# Usa SOLO la clave pública ("anon" o "publishable"). NUNCA la "service_role" / "secret":
# el script se negará a usarla.
#
# Si dejas ambas vacías, la app funciona en modo demostración (datos locales, sin login real).

SUPABASE_URL=
SUPABASE_ANON_KEY=
